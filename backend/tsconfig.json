{
  "compilerOptions": {
    /* --- 关键设置 --- */
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,

    /* --- 推荐设置 --- */
    "target": "ES2018",      /* 编译成一个你的旧 Node 版本能懂的 JS 版本 */
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*",
    "test-deepseek.ts"
  ]
}