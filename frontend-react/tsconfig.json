{
  "compilerOptions": {
    "target": "es2018", 
    "module": "commonjs", 
    "moduleResolution": "node", 
    "lib": ["es2018", "dom"],  
    "esModuleInterop": true,    
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist" 
  },
  "include": ["src"],   
  "exclude": ["node_modules"]
}