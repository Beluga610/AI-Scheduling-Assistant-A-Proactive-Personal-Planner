{
  "name": "llm-calendar-monorepo",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm:dev-backend\" \"npm:dev-frontend\"",
    "dev-backend": "npm --prefix backend run dev",
    "dev-frontend": "npm --prefix frontend-react run dev",
    "build": "npm --prefix frontend-react run build && npm --prefix backend run build"
  },
  "devDependencies": {
    "concurrently": "^7.0.0"
  }
}
